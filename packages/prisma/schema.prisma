generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Movimiento de caja menor: ingreso o egreso registrado por el negocio.
model Movimiento {
  id          Int      @id @default(autoincrement())
  tipo        String // "ingreso" | "egreso"
  monto       Decimal  @db.Decimal(12, 2)
  categoria   String
  descripcion String?
  fecha       DateTime @default(now())
  creadoEn    DateTime @default(now())

  @@index([tipo, fecha])
  @@map("movimientos")
}