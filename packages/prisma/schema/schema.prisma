// ============================================================
// Schema base — Prisma multi-file (prismaSchemaFolder)
//
// La app está ordenada por dominios (identidad global / caja).
// El schema se divide IGUAL que la estructura de la app:
//   schema.prisma    → datasource, generator, enums compartidos
//   identidad.prisma → Organization, Member (USER GLOBAL multitenancy)
//   caja.prisma      → Categoria, Movimiento + post-MVP (neto, sin mock)
//
// DECISIÓN (vault: arquitectura-multi-app-sesion-theme):
//   User/Organization/Member son GLOBALES a nivel de datos.
//   La separación "por campo" es SOLO de UI. Un futuro campo
//   Services NO re-registra usuarios.
// ============================================================
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums GLOBALES (compartidos por ignorancia/cliente de la caja) ----------
enum Rol {
  ADMIN      // dueño de la caja (el profe)
  OPERADOR   // puede operar movimientos
  AUDITOR    // puede aprobar/revisar (arqueos, solicitudes)
}

enum TipoMovimiento {
  INGRESO
  EGRESO
}

enum EstadoMovimiento {
  CONFIRMADO
  ANULADO // nunca se borra: se anula con motivo y queda en AuditLog
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum EstadoArqueo {
  ABIERTO
  CERRADO
  DIFERENCIA
}
