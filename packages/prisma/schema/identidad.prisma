// ============================================================
// MÓDULO IDENTIDAD — GLOBAL a nivel de datos (multitenancy real)
//
// La estructura sigue la tabla multi-nivel del vault:
//   Organization = el "negocio" — la caja del profe.
//   Member       = UNA persona dentro de la org (el user/login).
//
// DECISIÓN CLAVE (no negociable, vault: arquitectura-multi-app-sesion-theme):
//   User/Organization/Member son GLOBALES en los DATOS.
//   La separación "por app" (caja vs futuro módulo) es SOLO de UI.
//   Un futuro campo "Services" NO re-registra usuarios: reutiliza esto.
//
// POR QUÉ login va ACÁ (y no en la app):
//   El schema es La Fuente. Si el login vive en la UI de app-shell
//   y la identidad SOLO en la tabla de caja, el 2º módulo financiero
//   tendría que re-inventar usuarios. Multitenancy desde el día 1.
// ============================================================

model Organization {
  id          String   @id @default(cuid())
  nombre      String
  slug        String   @unique // identidad amigable para URL (ej: "zonarosa")
  // Perfil del negocio (onboarding) — alimenta recomendación de módulos
  tipoNegocio String?  /// "gimnasio" | "comercio" | "restaurante" | ...
  moneda      String   @default("COP")
  pais        String?  /// código ISO (ej: "CO")
  logoUrl     String?
  rolDefault  Rol      @default(OPERADOR)
  caja        Caja?    // 1:1 — el paquete de config de la caja
  members     Member[]
  modules     OrganizationModule[] // módulos habilitados para este negocio
  movimientos       Movimiento[]
  categorias        Categoria[]
  solicitudes       SolicitudFondo[]
  arqueos           Arqueo[]
  adjuntos          Adjunto[]
  auditLogs         AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model Member {
  id           String    @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  nombre       String
  email        String   // identidad de login: una persona puede pertenecer a varias orgs
  passwordHash String?  // login real (bcrypt). null = pendiente invitación
  rol          Rol       @default(OPERADOR)
  scope        UserScope @default(USER) // USER | CEO — consola global (futuro)
  activo       Boolean   @default(true) // desactivar ≠ borrar (decisión: nunca se borra identidad)
  movimientos Movimiento[]        @relation("responsable")
  solicitudesCreadas  SolicitudFondo[] @relation("solicitante")
  solicitudesValidadas SolicitudFondo[] @relation("validador")
  arqueos     Arqueo[]    @relation("arqueador")
  adjuntos    Adjunto[]   @relation("adjunto")
  auditLogs   AuditLog[]  @relation("auditor")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
  @@unique([email, orgId]) // una persona por org (permite multi-org)
  @@map("members")
}

// ============================================================
// MÓDULOS — catálogo GLOBAL de NEXUS (nivel 1 del producto).
// El cliente solo ve esto + las secciones de cada módulo.
// `campo` es taxonomía INTERNA (Finance/Services/...): invisible al cliente.
// ============================================================

model Module {
  id          String          @id @default(cuid())
  slug        String          @unique // "clientes" | "caja-menor" | "facturacion" | ...
  nombre      String
  descripcion String
  campo       CampoModulo             // taxonomía INTERNA (invisible al cliente)
  icono       String?                 // emoji/identificador visual
  /// Módulo BASE: se activa automáticamente en toda organización al crearla
  /// (ej: "clientes"). No es contratable ni se puede desactivar.
  porDefecto  Boolean         @default(false)
  /// Tipos de negocio para los que se recomienda este módulo
  /// (ej: "gimnasio" → presupuestos para control de gastos de máquinas).
  sugeridoPara String[]        @default([])
  activo      Boolean         @default(true)
  orden       Int             @default(0)
  organizaciones OrganizationModule[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("modules")
}

/// Habilitación de un módulo en un negocio: ACTIVO (se usa) o SOLICITADO (pedido).
model OrganizationModule {
  id         String          @id @default(cuid())
  orgId      String
  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  moduleId   String
  module     Module          @relation(fields: [moduleId], references: [id])
  estado     EstadoModuloOrg @default(SOLICITADO)
  activadoAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([orgId, moduleId])
  @@index([orgId])
  @@map("organization_modules")
}

/// 1:1 por org — configuración de la caja (saldo mínimo, categorías por defecto)
model Caja {
  id              String   @id @default(cuid())
  orgId           String   @unique
  org             Organization @relation(fields: [orgId], references: [id])
  saldoMinimo     Decimal  @default(0) @db.Decimal(12,2)
  permiteSaldoNegativo Boolean @default(false) // F3/C → impedir, no avisar nomás
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cajas")
}
