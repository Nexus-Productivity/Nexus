// ============================================================
// MÓDULO CAJA — dominio financiero del negocio (el propósito)
//
// DECISIÓN del profe (vault, sesión arquitectura-multi-app-sesion-theme):
//   A) OPERA SOLO él, pero QUIERE arqueo diario. → sin roles pesados
//      hoy: Member.rol default OPERADOR alcanza.
//   B) Categorías FIJAS por defecto (víveres, transporte, útiles,
//      materiales, imprevistos) + el profe agrega libres.
//      → Categoria.esPorDefecto (seed las crea, no son hardcode UI).
//   C) NO saldo negativo (se IMPIDE al validar el egreso) y un
//      movimiento erróneo se ANULA con motivo — nunca se borra.
//      → EstadoMovimiento.ANULADO + motivoAnulacion + AuditLog.
//
// Regla "no borrar movimientos" es de NEGOCIO (el profe la pidió
// explícitamente). Está a nivel de schema + servicio (F2), no solo UI.
// ============================================================

/// Categoría de movimiento — fijas por defecto + libres del profe
model Categoria {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  nombre       String
  esPorDefecto Boolean      @default(false) // true = seed la creó (víveres, transporte…)
  tipoMovimiento TipoMovimiento // INGRESO o EGRESO (define si aparece en egresos o ingresos)
  movimientos  Movimiento[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([orgId, nombre])
  @@index([orgId, tipoMovimiento])
  @@map("categorias")
}

/// Movimiento de caja (caja menor). NUNCA se borra: CONFIRMADO o ANULADO
model Movimiento {
  id              String         @id @default(cuid())
  orgId           String
  org             Organization   @relation(fields: [orgId], references: [id])
  tipo            TipoMovimiento // ENUM real (antes era String suelto)
  monto           Decimal        @db.Decimal(12, 2)
  categoriaId     String
  categoria       Categoria      @relation(fields: [categoriaId], references: [id])
  descripcion     String?
  fecha           DateTime       @default(now())
  estado          EstadoMovimiento @default(CONFIRMADO)
  motivoAnulacion String?        // obligatorio si estado == ANULADO
  creadoPorId     String
  creadoPor       Member         @relation("responsable", fields: [creadoPorId], references: [id])
  adjuntos        Adjunto[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([orgId, fecha])
  @@index([orgId, categoriaId])
  @@map("movimientos")
}

/// Reposición de fondos — flujo PENDIENTE → APROBADA/RECHAZADA (post-MVP)
model SolicitudFondo {
  id           String          @id @default(cuid())
  orgId        String
  org          Organization    @relation(fields: [orgId], references: [id])
  solicitanteId String
  solicitante  Member          @relation("solicitante", fields: [solicitanteId], references: [id])
  validadorId  String?
  validador    Member?         @relation("validador", fields: [validadorId], references: [id])
  monto        Decimal         @db.Decimal(12, 2)
  motivo       String
  estado       EstadoSolicitud @default(PENDIENTE)
  motivoRespuesta String?      // al aprobar o rechazar
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([orgId, estado])
  @@map("solicitudes_fondo")
}

/// Arqueo diario — conteo físico vs sistema (el profe lo pidió explícito)
model Arqueo {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  arqueadorId  String
  arqueador    Member       @relation("arqueador", fields: [arqueadorId], references: [id])
  conteoFisico Decimal      @db.Decimal(12, 2)
  diferencia   Decimal      @default(0) @db.Decimal(12, 2) // físico − sistema
  estado       EstadoArqueo @default(ABIERTO)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orgId, createdAt])
  @@map("arqueos")
}

/// Comprobante/adjunto de un movimiento (storage local primero → cloud)
model Adjunto {
  id           String     @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  movimientoId String
  movimiento   Movimiento @relation(fields: [movimientoId], references: [id])
  nombreArchivo String
  mimeType     String
  tamanoBytes  Int
  urlLocal     String     // storage local del homelab primero
  subidoPorId  String
  subidoPor    Member     @relation("adjunto", fields: [subidoPorId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([movimientoId])
  @@map("adjuntos")
}

/// Trazabilidad — quién hizo qué y cuándo (NUNCA se borra)
model AuditLog {
  id           String    @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  actorId      String
  actor        Member    @relation("auditor", fields: [actorId], references: [id])
  accion       String    // "crear_movimiento" | "anular_movimiento" | "crear_solicitud" | …
  entidad      String    // "Movimiento" | "SolicitudFondo" | "Arqueo"
  entidadId    String    // id del registro afectado
  detalle      Json?     // cambios antes/después, motivo, etc.
  createdAt    DateTime  @default(now())

  @@index([orgId, createdAt])
  @@map("audit_logs")
}
